{
  "version": 1,
  "enforcedPrefixes": [
    "src/backend/",
    "src/main/",
    "src/renderer/"
  ],
  "features": [
    {
      "id": "backend",
      "path": "src/backend/",
      "defaultTier": "infrastructure",
      "reason": "Composition root of the backend utilityProcess: wiring only",
      "overrides": [
        {
          "path": "src/backend/adapters/",
          "tier": "important",
          "reason": "Glue to Pi, OpenWorkflow, node:sqlite and Hono, including the HTTP security guards"
        },
        {
          "path": "src/backend/profile/",
          "tier": "core",
          "reason": "Per-document style profile read and written by both workflows"
        },
        {
          "path": "src/backend/correction/",
          "tier": "core",
          "reason": "The stylistic workflow: prompts, schemas and normalization the corrections exist for"
        },
        {
          "path": "src/backend/feedback/",
          "tier": "core",
          "reason": "The feedback workflow that turns the author's comments into profile changes"
        },
        {
          "path": "src/backend/ports/",
          "tier": "infrastructure",
          "reason": "Interface declarations only"
        }
      ]
    },
    {
      "id": "shell",
      "path": "src/main/",
      "defaultTier": "important",
      "reason": "Electron main process: backend supervisor, paths, tray and window",
      "overrides": [
        {
          "path": "src/main/index.ts",
          "tier": "infrastructure",
          "reason": "Pure re-export barrel"
        },
        {
          "path": "src/main/app.ts",
          "tier": "infrastructure",
          "reason": "Electron lifecycle wiring, exercised by launching the app"
        },
        {
          "path": "src/main/backend-host.ts",
          "tier": "infrastructure",
          "reason": "Forks the utilityProcess; exercised by launching the app"
        },
        {
          "path": "src/main/ipc-provider.ts",
          "tier": "infrastructure",
          "reason": "Electron IPC wiring, exercised by launching the app"
        },
        {
          "path": "src/main/ipc-word.ts",
          "tier": "infrastructure",
          "reason": "Electron IPC wiring, exercised by launching the app"
        }
      ]
    },
    {
      "id": "renderer",
      "path": "src/renderer/",
      "defaultTier": "important",
      "reason": "Hub screens: Home, Word, Server and Provider",
      "overrides": [
        {
          "path": "src/renderer/main.tsx",
          "tier": "infrastructure",
          "reason": "React mount point"
        }
      ]
    }
  ]
}
