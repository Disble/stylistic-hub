{
  "name": "stylistic-hub",
  "version": "0.0.1",
  "description": "Windows desktop hub for Stylistic: installs the Word add-in and runs the local backend",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "disble",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:providers": "bun src/backend/check-providers.ts",
    "test:coverage": "vitest run --coverage --config .dharness/vitest.coverage.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage",
    "dist": "bun run build && electron-builder --win nsis --x64",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@fluentui/react-components": "9.74.9",
    "@hono/node-server": "2.1.5",
    "@peculiar/x509": "2.2.0",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "dharness-eslint-plugin": "^0.4.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
