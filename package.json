{
  "name": "stylistic-hub",
  "version": "1.0.0",
  "description": "Windows desktop hub for Stylistic: installs the Word add-in and runs the local backend",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "disble",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:server": "vite build --config vite.server.config.ts && bun scripts/release/build-server.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:word": "bun scripts/check-word-session.ts",
    "check:providers": "bun src/backend/check-providers.ts",
    "addin:bundle": "bun scripts/bundle-addin.ts",
    "keys:dev": "bun scripts/keys/dev-keys.ts",
    "release:server": "cd src/backend && semantic-release",
    "release:hub": "semantic-release",
    "test:coverage": "vitest run --coverage --config .dharness/vitest.coverage.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run check:word",
    "dist": "bun run build && bun scripts/stage-word.ts && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "bun run build && bun scripts/stage-word.ts && electron-builder --win dir --x64",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@peculiar/asn1-schema": "2.11.0",
    "@peculiar/asn1-x509": "2.11.0",
    "@peculiar/x509": "2.2.0",
    "electron-updater": "6.8.10",
    "hono": "4.13.13",
    "openworkflow": "0.11.0",
    "reflect-metadata": "0.2.2",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.344",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/adm-zip": "0.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "adm-zip": "0.6.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "dharness-eslint-plugin": "^0.4.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "semantic-release-monorepo": "8.0.2",
    "supports-color": "7.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "yazl": "3.3.1"
  }
}
