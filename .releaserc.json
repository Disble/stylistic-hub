{
  "tagFormat": "hub-v${version}",
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": "beta"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Stylistic Hub changelog"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun run dist && bun scripts/release/pack-component.ts --file release/StylisticHub-Setup-${nextRelease.version}.exe --out release --id stylistic-hub --kind hub --version ${nextRelease.version} --channel ${nextRelease.channel ? 'beta' : 'stable'} --release-notes https://github.com/Disble/stylistic-hub/releases/tag/hub-v${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): hub ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "releasedLabels": false,
        "assets": [
          {
            "path": "release/StylisticHub-Setup-*.exe",
            "label": "Windows installer"
          },
          {
            "path": "release/component.json",
            "label": "component.json"
          },
          {
            "path": "release/component.json.sig",
            "label": "component.json.sig"
          }
        ]
      }
    ]
  ]
}
